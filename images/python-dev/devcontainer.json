{
  // Definition for the python-service devcontainer image.
  // This file is used by CI to build and push the image to GHCR.
  // Service repos reference the resulting image — they do not build it themselves.
  "name": "python-dev",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    // Python — pin to major.minor so patch updates flow automatically
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "installTools": true
    },
    // Docker-outside-of-Docker — mounts host socket, no nested daemon, no privileged container
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // kubectl + Helm — local cluster management via k3d; minikube binary included but unused
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.36",
      "helm": "4.1.4",
      "minikube": "1.38.1"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.92.0"
    },
    // Node.js stable — required for Claude Code CLI
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26",
      "nodeGypDependencies": false
    }
  },

  // postCreateCommand runs on every create AND rebuild — ensures binaries are always present.
  // Symlink into /usr/local/bin so they shadow VS Code's own copilot injected by vscode-server.
  "postCreateCommand": "npm install -g @github/copilot @anthropic-ai/claude-code && sudo ln -sf $(npm prefix -g)/bin/copilot /usr/local/bin/copilot && sudo ln -sf $(npm prefix -g)/bin/claude /usr/local/bin/claude && curl -s https://raw.githubusercontent.com/k3d-io/k3d/main/install.sh | bash",

  // k3d is idempotent: create cluster on first start, start existing cluster on subsequent starts.
  "postStartCommand": "k3d cluster list | grep -q devcontainer && k3d cluster start devcontainer || k3d cluster create devcontainer",

  "mounts": [
    // Persist gh credentials across all dever-labs devcontainers.
    // Run `gh auth login` once — every container that mounts this volume gets your credentials.
    "source=dever-labs-gh-config,target=/home/vscode/.config/gh,type=volume",
    // Persist Copilot CLI credentials (stored at ~/.copilot/config.json on headless Linux).
    // Run `copilot /login` once — all containers with this volume stay authenticated.
    "source=dever-labs-copilot,target=/home/vscode/.copilot,type=volume"
  ],

  "remoteEnv": {
    // Put /usr/local/bin first so npm-installed copilot/claude shadow the VS Code extension binaries.
    "PATH": "/usr/local/bin:${containerEnv:PATH}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // AI agents
        "github.copilot",
        "github.copilot-chat",
        "anthropics.claude-code",
        // Python
        "ms-python.python",
        "ms-python.pylance",
        "ms-python.black-formatter"
      ]
    }
  }
}
