#!/bin/sh
# k3d cluster lifecycle: create (with devcontainer network) on first start, resume on restart.
# kubeconfig is merged with --internal so kubectl reaches the k3s API from inside the container.
#
# Set K3D_CLUSTER_NAME in your devcontainer remoteEnv to isolate clusters across repos.
set -e

CLUSTER_NAME="${K3D_CLUSTER_NAME:-devcontainer}"

if k3d cluster list 2>/dev/null | grep -q "${CLUSTER_NAME}"; then
  k3d cluster start "${CLUSTER_NAME}"
else
  NET=$(docker inspect "$(hostname)" \
    --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' \
    2>/dev/null | grep -Ev "^(bridge|host|none)$" | head -1)
  k3d cluster create "${CLUSTER_NAME}" ${NET:+--network $NET}
fi

k3d kubeconfig merge "${CLUSTER_NAME}" --kubeconfig-merge-default --internal
