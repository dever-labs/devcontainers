#!/usr/bin/env bash
# dever-gh-login: sign in to gh with your GitHub token kept in OpenBao.
#
# Signs in to OpenBao (vault.dever.dk) with your Idently account (OIDC), reads your
# GitHub token from dever/users/<you>/github and hands it to `gh auth login`.
# The token is written to the shared dever-labs-gh-config volume, so every dever-labs
# devcontainer picks it up. When the token expires, store a new one in OpenBao and
# run this again; nothing on your host machine needs to change.
#
# Usage:
#   dever-gh-login           log in with the token stored in OpenBao
#   dever-gh-login --store   prompt for a new token, store it in OpenBao, then log in
set -euo pipefail

export BAO_ADDR="${BAO_ADDR:-https://vault.dever.dk}"
MOUNT="${DEVER_BAO_MOUNT:-dever}"

# gh refuses `auth login` while these are set, and an expired one would also win over stored credentials.
unset GITHUB_TOKEN GH_TOKEN

need_login=1
if bao token lookup >/dev/null 2>&1; then need_login=0; fi
if [ "$need_login" = 1 ]; then
  echo "==> Signing in to OpenBao (${BAO_ADDR}) with your Idently account..."
  bao login -method=oidc -no-print
fi

USER_NAME="$(bao token lookup -format=json | jq -r '.data.meta.username // empty')"
if [ -z "$USER_NAME" ]; then
  echo "Could not determine your username from the OpenBao token." >&2
  exit 1
fi
SECRET_PATH="users/${USER_NAME}/github"

if [ "${1:-}" = "--store" ]; then
  printf 'GitHub token (input hidden): ' >&2
  read -rs NEW_TOKEN
  echo >&2
  [ -n "$NEW_TOKEN" ] || { echo "Empty token." >&2; exit 1; }
  printf '%s' "$NEW_TOKEN" | bao kv put -mount="$MOUNT" "$SECRET_PATH" token=- >/dev/null
  unset NEW_TOKEN
  echo "==> Stored in OpenBao at ${MOUNT}/${SECRET_PATH}"
fi

if ! TOKEN="$(bao kv get -mount="$MOUNT" -field=token "$SECRET_PATH" 2>/dev/null)"; then
  echo "No GitHub token stored at ${MOUNT}/${SECRET_PATH}." >&2
  echo "Create a token at https://github.com/settings/tokens and run: dever-gh-login --store" >&2
  exit 1
fi

printf '%s' "$TOKEN" | gh auth login --hostname github.com --with-token
unset TOKEN
gh auth status
