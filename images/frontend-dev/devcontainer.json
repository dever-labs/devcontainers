{
  // Definition for the frontend devcontainer image.
  // This file is used by CI to build and push the image to GHCR.
  // Service repos reference the resulting image — they do not build it themselves.
  "name": "frontend-dev",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    // Node.js stable with corepack — enables pnpm via `corepack enable pnpm`
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26",
      "nodeGypDependencies": false
    },
    // Docker-outside-of-Docker — mounts host socket, no nested daemon, no privileged container
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // kubectl + Helm — local cluster management via k3d
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.36",
      "helm": "4.1.4",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.92.0"
    }
  },

  "postCreateCommand": "bash .devcontainer/init.sh",

  // k3d cluster lifecycle: create (with devcontainer network) on first start, resume on restart.
  // kubeconfig is merged with --internal so kubectl reaches the k3s API from inside the container.
  "postStartCommand": "if k3d cluster list 2>/dev/null | grep -q devcontainer; then k3d cluster start devcontainer; else NET=$(docker inspect $(hostname) --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{\"\\n\"}}{{end}}' 2>/dev/null | grep -Ev '^(bridge|host|none)$' | head -1); k3d cluster create devcontainer ${NET:+--network $NET}; fi; k3d kubeconfig merge devcontainer --kubeconfig-merge-default --internal",

  "remoteEnv": {
    "PATH": "/usr/local/bin:${containerEnv:PATH}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },

  "mounts": [
    // Persist gh credentials across all dever-labs devcontainers.
    // Run `gh auth login` once — every container that mounts this volume gets your credentials.
    "source=dever-labs-gh-config,target=/home/vscode/.config/gh,type=volume",
    // Persist Copilot CLI credentials (stored at ~/.copilot/config.json on headless Linux).
    // Run `copilot /login` once — all containers with this volume stay authenticated.
    "source=dever-labs-copilot,target=/home/vscode/.copilot,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        // AI agents
        "github.copilot",
        "github.copilot-chat",
        "anthropics.claude-code",
        // Frontend
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-typescript-next"
      ]
    }
  }
}
