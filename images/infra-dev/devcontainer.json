{
  // Definition for the infra devcontainer image.
  // This file is used by CI to build and push the image to GHCR.
  // Service repos reference the resulting image -- they do not build it themselves.
  "name": "infra-dev",
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    // Terraform -- IaC for cloud infrastructure
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.15.2"
    },
    // Azure CLI -- primary cloud provider
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "2.86.0"
    },
    // Docker-outside-of-Docker — mounts host socket, no nested daemon, no privileged container
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    // kubectl + Helm — local cluster management via k3d; minikube binary included but unused
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "1.36",
      "helm": "4.1.4",
      "minikube": "1.38.1"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "2.92.0"
    },
    // Node.js stable — required for Claude Code CLI
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26",
      "nodeGypDependencies": false
    }
  },

  // AWS CLI, GCP SDK and ArgoCD CLI installed via shell — devcontainers-contrib features
  // are unreliable in CI (access/permissions issues).
  // All downloads are arch-aware so the image works on both amd64 and arm64.
  "postCreateCommand": "npm install -g @github/copilot @anthropic-ai/claude-code && sudo ln -sf $(npm prefix -g)/bin/copilot /usr/local/bin/copilot && sudo ln -sf $(npm prefix -g)/bin/claude /usr/local/bin/claude && curl -fsSL https://raw.githubusercontent.com/k3d-io/k3d/v5.8.3/install.sh | TAG=v5.8.3 bash",

  // k3d cluster lifecycle: create (with devcontainer network) on first start, resume on restart.
  // kubeconfig is merged with --internal so kubectl reaches the k3s API from inside the container.
  "postStartCommand": "if k3d cluster list 2>/dev/null | grep -q devcontainer; then k3d cluster start devcontainer; else NET=$(docker inspect $(hostname) --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' 2>/dev/null | awk '{print $1}'); k3d cluster create devcontainer ${NET:+--network $NET}; fi; k3d kubeconfig merge devcontainer --kubeconfig-merge-default --internal",

  "mounts": [
    // Persist gh credentials across all dever-labs devcontainers.
    // Run `gh auth login` once — every container that mounts this volume gets your credentials.
    "source=dever-labs-gh-config,target=/home/vscode/.config/gh,type=volume",
    // Persist Copilot CLI credentials (stored at ~/.copilot/config.json on headless Linux).
    // Run `copilot /login` once — all containers with this volume stay authenticated.
    "source=dever-labs-copilot,target=/home/vscode/.copilot,type=volume"
  ],

  "remoteEnv": {
    "PATH": "/usr/local/bin:${containerEnv:PATH}",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // AI agents
        "github.copilot",
        "github.copilot-chat",
        "anthropics.claude-code",
        // Infrastructure
        "hashicorp.terraform",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-azuretools.vscode-azureterraform",
        "redhat.vscode-yaml"
      ]
    }
  }
}
