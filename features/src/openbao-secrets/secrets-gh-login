#!/usr/bin/env bash
# secrets-gh-login: log gh in with a GitHub token stored in an OpenBao/Vault server.
#
# Entirely configured by environment variables (set them in your own devcontainer.json
# remoteEnv / containerEnv); there are no built-in server addresses or paths.
#
#   BAO_ADDR              required  server URL
#   BAO_SECRET_MOUNT      required  KV v2 mount, e.g. "secret"
#   BAO_SECRET_PATH       required  secret path inside the mount holding the token
#   BAO_SECRET_FIELD      optional  field name (default: token)
#   BAO_LOGIN_ARGS        optional  args for `bao login` (default: -method=oidc skip_browser=true)
#
# Usage:
#   secrets-gh-login           read the token and run `gh auth login --with-token`
#   secrets-gh-login --store   prompt for a new token, store it, then log in
set -euo pipefail

: "${BAO_ADDR:?set BAO_ADDR}"
: "${BAO_SECRET_MOUNT:?set BAO_SECRET_MOUNT}"
: "${BAO_SECRET_PATH:?set BAO_SECRET_PATH}"
FIELD="${BAO_SECRET_FIELD:-token}"
export BAO_ADDR

# An expired GITHUB_TOKEN/GH_TOKEN would override stored credentials and block `gh auth login`.
unset GITHUB_TOKEN GH_TOKEN

if ! bao token lookup >/dev/null 2>&1; then
  echo "==> Signing in to ${BAO_ADDR}: open the URL printed below in your host browser."
  # shellcheck disable=SC2086
  bao login ${BAO_LOGIN_ARGS:--method=oidc skip_browser=true} -no-print
fi

if [ "${1:-}" = "--store" ]; then
  printf 'GitHub token (input hidden): ' >&2
  read -rs NEW_TOKEN
  echo >&2
  [ -n "$NEW_TOKEN" ] || { echo "Empty token." >&2; exit 1; }
  printf '%s' "$NEW_TOKEN" | bao kv put -mount="$BAO_SECRET_MOUNT" "$BAO_SECRET_PATH" "${FIELD}=-" >/dev/null
  unset NEW_TOKEN
  echo "==> Stored at ${BAO_SECRET_MOUNT}/${BAO_SECRET_PATH}"
fi

TOKEN="$(bao kv get -mount="$BAO_SECRET_MOUNT" -field="$FIELD" "$BAO_SECRET_PATH")"
printf '%s' "$TOKEN" | gh auth login --hostname github.com --with-token
unset TOKEN
gh auth status
