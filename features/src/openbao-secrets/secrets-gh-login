#!/usr/bin/env bash
# secrets-gh-login: log gh in with a GitHub token stored in an OpenBao/Vault server.
#
# Sign-in uses the OIDC device-code flow (no browser or open ports in the container) and the
# resulting refresh token is kept in a volume shared by every devcontainer, so after one
# sign-in all containers re-authenticate silently until the refresh token expires.
#
# Everything is configured by environment variables; there are no built-in servers or paths.
#   OIDC_ISSUER        required  issuer URL (must serve /.well-known/openid-configuration)
#   OIDC_CLIENT_ID     required  public client with the device-code grant enabled
#   BAO_ADDR           required  OpenBao/Vault URL
#   BAO_JWT_ROLE       required  role on the JWT auth method that accepts the access token
#   BAO_SECRET_MOUNT   required  KV v2 mount, e.g. "secret"
#   BAO_SECRET_PATH    required  secret path holding the GitHub token
#   BAO_SECRET_FIELD   optional  field name (default: token)
#   BAO_JWT_MOUNT      optional  JWT auth mount (default: jwt)
#   OIDC_SCOPE         optional  default: "openid offline_access"
#
# Usage:
#   secrets-gh-login           sign in if needed, then gh auth login with the stored token
#   secrets-gh-login --auto    same, but silent and non-blocking (used at container start)
#   secrets-gh-login --store   prompt for a new GitHub token and store it first
set -euo pipefail

MODE="${1:-}"
if [ "$MODE" = "--auto" ]; then
  # Container start must never fail or hang because of this script.
  trap 'exit 0' EXIT
  if [ -z "${BAO_ADDR:-}" ]; then exit 0; fi
fi

: "${OIDC_ISSUER:?set OIDC_ISSUER}"
: "${OIDC_CLIENT_ID:?set OIDC_CLIENT_ID}"
: "${BAO_ADDR:?set BAO_ADDR}"
: "${BAO_JWT_ROLE:?set BAO_JWT_ROLE}"
: "${BAO_SECRET_MOUNT:?set BAO_SECRET_MOUNT}"
: "${BAO_SECRET_PATH:?set BAO_SECRET_PATH}"
FIELD="${BAO_SECRET_FIELD:-token}"
JWT_MOUNT="${BAO_JWT_MOUNT:-jwt}"
SCOPE="${OIDC_SCOPE:-openid offline_access}"
STATE_DIR="${HOME}/.bao-session"
REFRESH_FILE="${STATE_DIR}/refresh_token"
export BAO_ADDR

# An expired GITHUB_TOKEN/GH_TOKEN would override stored credentials and block `gh auth login`.
unset GITHUB_TOKEN GH_TOKEN

# gh already works: only touch the refresh token if it is getting old, so an IdP idle timeout
# on refresh tokens never lapses while gh stays logged in.
GH_OK=0
if gh auth status >/dev/null 2>&1; then GH_OK=1; fi
if [ "$MODE" != "--store" ] && [ "$GH_OK" = 1 ] \
   && [ -n "$(find "${STATE_DIR}/refresh_token" -mtime -7 2>/dev/null)" ]; then exit 0; fi
# gh was logged in some other way (no refresh token here): nothing to do or nag about at start.
if [ "$MODE" = "--auto" ] && [ "$GH_OK" = 1 ] && [ ! -s "${STATE_DIR}/refresh_token" ]; then exit 0; fi

log() { [ "$MODE" = "--auto" ] || echo "$@" >&2; }
mkdir -p "$STATE_DIR"; chmod 700 "$STATE_DIR"

# One container at a time, so a rotated refresh token is never used twice.
exec 9>"${STATE_DIR}/lock"
if [ "$MODE" = "--auto" ]; then flock -w 20 9 || exit 0; else flock 9; fi

DISCOVERY="$(curl -fsS "${OIDC_ISSUER%/}/.well-known/openid-configuration")"
TOKEN_URL="$(jq -r .token_endpoint <<<"$DISCOVERY")"
DEVICE_URL="$(jq -r .device_authorization_endpoint <<<"$DISCOVERY")"

ACCESS=""
if [ -s "$REFRESH_FILE" ]; then
  if RESP="$(curl -fsS "$TOKEN_URL" -d grant_type=refresh_token -d "client_id=${OIDC_CLIENT_ID}" \
        --data-urlencode "refresh_token@${REFRESH_FILE}" 2>/dev/null)"; then
    ACCESS="$(jq -r .access_token <<<"$RESP")"
    NEW_REFRESH="$(jq -r '.refresh_token // empty' <<<"$RESP")"
    if [ -n "$NEW_REFRESH" ]; then (umask 077; printf '%s' "$NEW_REFRESH" >"$REFRESH_FILE"); fi
  else
    rm -f "$REFRESH_FILE"
  fi
fi

if [ -z "$ACCESS" ]; then
  if [ "$MODE" = "--auto" ] || [ ! -t 0 ]; then
    echo "secrets-gh-login: sign-in needed. Run 'secrets-gh-login' in a terminal." >&2
    exit 0
  fi
  DEV="$(curl -fsS "$DEVICE_URL" -d "client_id=${OIDC_CLIENT_ID}" --data-urlencode "scope=${SCOPE}")"
  echo "Open $(jq -r '.verification_uri_complete // .verification_uri' <<<"$DEV") on any device" >&2
  echo "and enter the code: $(jq -r .user_code <<<"$DEV")" >&2
  INTERVAL="$(jq -r '.interval // 5' <<<"$DEV")"
  DEADLINE=$(( $(date +%s) + $(jq -r '.expires_in // 600' <<<"$DEV") ))
  while [ "$(date +%s)" -lt "$DEADLINE" ]; do
    sleep "$INTERVAL"
    RESP="$(curl -sS "$TOKEN_URL" -d grant_type=urn:ietf:params:oauth:grant-type:device_code \
      -d "client_id=${OIDC_CLIENT_ID}" -d "device_code=$(jq -r .device_code <<<"$DEV")")"
    ERR="$(jq -r '.error // empty' <<<"$RESP")"
    case "$ERR" in
      "") ACCESS="$(jq -r .access_token <<<"$RESP")"
          NEW_REFRESH="$(jq -r '.refresh_token // empty' <<<"$RESP")"
          if [ -n "$NEW_REFRESH" ]; then (umask 077; printf '%s' "$NEW_REFRESH" >"$REFRESH_FILE"); fi
          break ;;
      authorization_pending) ;;
      slow_down) INTERVAL=$((INTERVAL + 5)) ;;
      *) echo "Sign-in failed: $ERR" >&2; exit 1 ;;
    esac
  done
  [ -n "$ACCESS" ] || { echo "Sign-in timed out." >&2; exit 1; }
fi

# Refresh-only run: gh still works, nothing more to do.
if [ "$MODE" != "--store" ] && [ "$GH_OK" = 1 ]; then exit 0; fi

# The OpenBao token stays in memory only.
BAO_TOKEN="$(bao write -field=token "auth/${JWT_MOUNT}/login" role="$BAO_JWT_ROLE" jwt=- <<<"$ACCESS")"
export BAO_TOKEN
unset ACCESS

if [ "$MODE" = "--store" ]; then
  printf 'GitHub token (input hidden): ' >&2
  read -rs NEW_TOKEN
  echo >&2
  [ -n "$NEW_TOKEN" ] || { echo "Empty token." >&2; exit 1; }
  printf '%s' "$NEW_TOKEN" | bao kv put -mount="$BAO_SECRET_MOUNT" "$BAO_SECRET_PATH" "${FIELD}=-" >/dev/null
  unset NEW_TOKEN
  log "==> Stored at ${BAO_SECRET_MOUNT}/${BAO_SECRET_PATH}"
fi

if ! TOKEN="$(bao kv get -mount="$BAO_SECRET_MOUNT" -field="$FIELD" "$BAO_SECRET_PATH" 2>/dev/null)"; then
  echo "secrets-gh-login: no GitHub token at ${BAO_SECRET_MOUNT}/${BAO_SECRET_PATH}; run 'secrets-gh-login --store'." >&2
  exit 0
fi
printf '%s' "$TOKEN" | gh auth login --hostname github.com --with-token
unset TOKEN
log "==> gh authenticated"
