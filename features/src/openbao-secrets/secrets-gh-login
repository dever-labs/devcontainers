#!/usr/bin/env bash
# secrets-gh-login: log gh in with a GitHub token stored in an OpenBao/Vault server.
#
# Sign-in is OpenBao's own OIDC login in the browser (`bao login -method=oidc`,
# callback to localhost:8250 in the container, which the editor forwards). The
# identity provider is configured on the server, as part of the OIDC role.
#
# Nothing long-lived is kept by this script: no identity-provider refresh token,
# and the OpenBao token stays in memory for this run and is revoked at the end.
# Sign in once in the browser and later logins (other containers, other tools
# using the same identity provider) are a redirect without a password prompt.
#
# Deliberately not supported: the device-code flow and `callbackmode=direct`.
# Both let a login started by someone else be completed by you, which is how
# sign-ins get phished, and neither is needed when the browser is on the same
# machine as the editor.
#
# Everything is configured by environment variables; there are no built-in servers or paths.
#   BAO_ADDR           required  OpenBao/Vault URL
#   BAO_SECRET_MOUNT   required  KV v2 mount, e.g. "secret"
#   BAO_SECRET_PATH    required  secret path holding the GitHub token
#   BAO_SECRET_FIELD   optional  field name (default: token)
#   BAO_OIDC_ROLE      optional  OIDC role (default: the auth method's default_role)
#   BAO_OIDC_MOUNT     optional  OIDC auth mount (default: oidc)
#   BAO_OIDC_PORT      optional  local callback port (default: 8250)
#
# Usage:
#   secrets-gh-login           sign in, then gh auth login with the stored token
#   secrets-gh-login --auto    at container start: never prompts, never blocks
#   secrets-gh-login --store   prompt for a new GitHub token and store it first
set -euo pipefail

MODE="${1:-}"
case "$MODE" in ""|--auto|--store) ;; *) echo "usage: secrets-gh-login [--auto|--store]" >&2; exit 2 ;; esac

if [ "$MODE" = "--auto" ]; then
  # Container start must never fail or hang because of this script, and a
  # browser login needs a person, so this only tells them what to run.
  trap 'exit 0' EXIT
  [ -n "${BAO_ADDR:-}" ] || exit 0
  # An expired GITHUB_TOKEN/GH_TOKEN would make gh look logged out.
  if (unset GITHUB_TOKEN GH_TOKEN; gh auth status >/dev/null 2>&1); then exit 0; fi
  echo "secrets-gh-login: gh isn't logged in. Run 'secrets-gh-login' in a terminal to sign in." >&2
  exit 0
fi

: "${BAO_ADDR:?set BAO_ADDR}"
: "${BAO_SECRET_MOUNT:?set BAO_SECRET_MOUNT}"
: "${BAO_SECRET_PATH:?set BAO_SECRET_PATH}"
FIELD="${BAO_SECRET_FIELD:-token}"
OIDC_MOUNT="${BAO_OIDC_MOUNT:-oidc}"
PORT="${BAO_OIDC_PORT:-8250}"
case "$PORT" in ''|*[!0-9]*) echo "BAO_OIDC_PORT must be a port number" >&2; exit 2 ;; esac
export BAO_ADDR

# An expired GITHUB_TOKEN/GH_TOKEN would override stored credentials and block `gh auth login`.
unset GITHUB_TOKEN GH_TOKEN
# Never use or keep a token from elsewhere: this run's token is the only one.
unset BAO_TOKEN VAULT_TOKEN

[ -t 0 ] || { echo "secrets-gh-login: run it in a terminal; sign-in opens a browser." >&2; exit 1; }

login_args=(login -method=oidc -path="$OIDC_MOUNT" -token-only
  callbackmode=client listenaddress=localhost port="$PORT")
[ -z "${BAO_OIDC_ROLE:-}" ] || login_args+=(role="$BAO_OIDC_ROLE")

echo "Signing in to ${BAO_ADDR} in your browser…" >&2
# -token-only prints the token and never hands it to a token helper or ~/.vault-token.
BAO_TOKEN="$(bao "${login_args[@]}")" || { echo "Sign-in failed." >&2; exit 1; }
[ -n "$BAO_TOKEN" ] || { echo "Sign-in returned no token." >&2; exit 1; }
export BAO_TOKEN
trap 'bao token revoke -self >/dev/null 2>&1 || true' EXIT

if [ "$MODE" = "--store" ]; then
  printf 'GitHub token (input hidden): ' >&2
  read -rs NEW_TOKEN
  echo >&2
  [ -n "$NEW_TOKEN" ] || { echo "Empty token." >&2; exit 1; }
  printf '%s' "$NEW_TOKEN" | bao kv put -mount="$BAO_SECRET_MOUNT" "$BAO_SECRET_PATH" "${FIELD}=-" >/dev/null
  unset NEW_TOKEN
  echo "==> Stored at ${BAO_SECRET_MOUNT}/${BAO_SECRET_PATH}" >&2
fi

if ! TOKEN="$(bao kv get -mount="$BAO_SECRET_MOUNT" -field="$FIELD" "$BAO_SECRET_PATH" 2>/dev/null)"; then
  echo "secrets-gh-login: no GitHub token at ${BAO_SECRET_MOUNT}/${BAO_SECRET_PATH}; run 'secrets-gh-login --store'." >&2
  exit 1
fi
printf '%s' "$TOKEN" | gh auth login --hostname github.com --with-token
unset TOKEN
echo "==> gh authenticated" >&2
