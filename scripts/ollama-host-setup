#!/usr/bin/env bash
# ollama-host-setup — run once on your host machine (not inside a devcontainer).
# Checks if Ollama is installed and serving, starts it if not.
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# 1. Check Ollama is installed
# ---------------------------------------------------------------------------

if ! command -v ollama &> /dev/null; then
  echo -e "${RED}✗ Ollama is not installed.${NC}"
  echo ""
  echo "Install it with:"
  echo "  curl -fsSL https://ollama.com/install.sh | sh"
  echo ""
  echo "On macOS:"
  echo "  brew install ollama"
  exit 1
fi

echo -e "${GREEN}✓ Ollama found${NC} at $(command -v ollama)"

# ---------------------------------------------------------------------------
# 2. Check if already serving
# ---------------------------------------------------------------------------

if curl -sf --max-time 2 http://localhost:11434/api/tags > /dev/null 2>&1; then
  echo -e "${GREEN}✓ Ollama is already running${NC} on port 11434 — reusing."
else
  echo -e "${YELLOW}→ Ollama is not running. Starting...${NC}"
  ollama serve &> /tmp/ollama-serve.log &
  OLLAMA_PID=$!

  # Wait up to 10s for the server to become ready
  for i in $(seq 1 20); do
    if curl -sf --max-time 1 http://localhost:11434/api/tags > /dev/null 2>&1; then
      echo -e "${GREEN}✓ Ollama started${NC} (PID ${OLLAMA_PID})"
      break
    fi
    sleep 0.5
    if [[ $i -eq 20 ]]; then
      echo -e "${RED}✗ Ollama did not start within 10 seconds.${NC}"
      echo "  Check logs: tail /tmp/ollama-serve.log"
      exit 1
    fi
  done
fi

# ---------------------------------------------------------------------------
# 3. Show available models
# ---------------------------------------------------------------------------

echo ""
echo "Available models:"
ollama list 2>/dev/null || echo "  (none)"

echo ""
echo "Recommended models for AI coding (pull if not listed above):"
echo "  ollama pull qwen2.5-coder:14b"
echo "  ollama pull deepseek-coder:16b"
