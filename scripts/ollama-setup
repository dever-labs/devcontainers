#!/usr/bin/env bash
# ollama-setup — run once on your host machine (not inside a devcontainer).
# Installs Ollama if missing, starts it, pulls the default AI coding models,
# and verifies the setup is ready for use with devcontainers.
set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

OLLAMA_URL="http://localhost:11434"
DEFAULT_MODELS=("qwen2.5-coder:14b" "deepseek-coder-v2:16b")

ok()   { echo -e "${GREEN}✓${NC} $*"; }
warn() { echo -e "${YELLOW}⚠${NC}  $*"; }
fail() { echo -e "${RED}✗${NC} $*"; }
step() { echo -e "\n${BOLD}$*${NC}"; }

# ---------------------------------------------------------------------------
# 1. Install Ollama if missing
# ---------------------------------------------------------------------------

step "1. Checking Ollama installation..."

if command -v ollama &>/dev/null; then
  ok "Ollama already installed: $(ollama --version 2>/dev/null || echo 'version unknown')"
else
  warn "Ollama not found. Installing..."
  if [[ "$(uname)" == "Darwin" ]]; then
    if command -v brew &>/dev/null; then
      brew install ollama
    else
      echo "  Homebrew not found. Downloading from ollama.com..."
      curl -fsSL https://ollama.com/install.sh | sh
    fi
  else
    curl -fsSL https://ollama.com/install.sh | sh
  fi
  ok "Ollama installed: $(ollama --version 2>/dev/null || echo 'version unknown')"
fi

# ---------------------------------------------------------------------------
# 2. Start Ollama if not running
# ---------------------------------------------------------------------------

step "2. Checking Ollama service..."

if curl -sf --max-time 2 "${OLLAMA_URL}/api/tags" >/dev/null 2>&1; then
  ok "Ollama already running on port 11434"
else
  warn "Ollama not running. Starting..."
  OLLAMA_HOST=0.0.0.0 ollama serve >/tmp/ollama-serve.log 2>&1 &
  OLLAMA_PID=$!

  for i in $(seq 1 20); do
    if curl -sf --max-time 1 "${OLLAMA_URL}/api/tags" >/dev/null 2>&1; then
      ok "Ollama started (PID ${OLLAMA_PID})"
      break
    fi
    sleep 0.5
    if [[ $i -eq 20 ]]; then
      fail "Ollama did not start within 10 seconds."
      echo "  Check logs: tail /tmp/ollama-serve.log"
      exit 1
    fi
  done
fi

# ---------------------------------------------------------------------------
# 3. Pull default models (background — non-blocking)
# ---------------------------------------------------------------------------

step "3. Pulling default models..."

AVAILABLE=$(curl -sf "${OLLAMA_URL}/api/tags" | grep -o '"name":"[^"]*"' | sed 's/"name":"//;s/"//' 2>/dev/null || echo "")

for model in "${DEFAULT_MODELS[@]}"; do
  if echo "${AVAILABLE}" | grep -qF "${model}"; then
    ok "${model} already present"
  else
    warn "${model} not found — pulling in background (first use may be slow until complete)"
    nohup bash -c "ollama pull '${model}' >> /tmp/ollama-pull-${model//[:\/]/-}.log 2>&1" &
  fi
done

# ---------------------------------------------------------------------------
# 4. Verify
# ---------------------------------------------------------------------------

step "4. Verifying setup..."

echo ""
echo "Installed models:"
ollama list

echo ""
API_STATUS=$(curl -sf --max-time 2 "${OLLAMA_URL}/api/tags" >/dev/null 2>&1 && echo "reachable" || echo "unreachable")
if [[ "$API_STATUS" == "reachable" ]]; then
  ok "API reachable at ${OLLAMA_URL}"
else
  fail "API not reachable at ${OLLAMA_URL}"
  exit 1
fi

echo ""
echo -e "${GREEN}${BOLD}✓ Ollama is ready.${NC}"
echo ""
echo "  Devcontainers will connect via: host.docker.internal:11434"
echo "  To keep Ollama running across reboots:"
if [[ "$(uname)" == "Darwin" ]]; then
  echo "    brew services start ollama"
else
  echo "    sudo systemctl enable --now ollama"
fi
